{
  "name": "vuestic-admin",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "workspaces": [
    "e2e"
  ],
  "scripts": {
    "prepare": "husky install",
    "dev": "vite",
    "build": "npm run lint && vue-tsc --noEmit && vite build",
    "build:ci": "vite build",
    "start:ci": "serve -s ./dist",
    "prelint": "npm run format",
    "lint": "eslint \"./src/**/*.{ts,js,vue}\" --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "e2e": "yarn workspace e2e test",
    "e2e:update-snapshots": "yarn workspace e2e update"
  },
  "lint-staged": {
    "./src/**/*.{ts,js,vue}": [
      "npm run lint"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1021.0",
    "@aws-sdk/client-pricing": "^3.1021.0",
    "@aws-sdk/credential-providers": "^3.1021.0",
    "@vuestic/compiler": "0.2.10",
    "aws-amplify": "^6.16.2",
    "axios": "^1.13.6",
    "chart.js": "^4.4.1",
    "chartjs-chart-matrix": "^3.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "dayjs": "^1.11.20",
    "epic-spinners": "^2.0.0",
    "pinia": "^2.1.7",
    "sass": "^1.69.5",
    "serve": "^14.2.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.0",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.2.5",
    "vuestic-ui": "^1.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@types/node": "^20.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.13",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.4.0",
    "husky": "^8.0.1",
    "lint-staged": "^15.1.0",
    "postcss": "^8.4.21",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^5.4.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.1.6"
  },
  "packageManager": "yarn@4.9.2"
}
